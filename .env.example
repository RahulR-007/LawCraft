# LawCraft AI — Environment Configuration
# Copy this to .env.local and fill in your values

# ============================================
# Supabase Configuration (Required)
# ============================================

# Supabase project URL and anonymous key (these are public/safe for client-side)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# AI API Configuration (Server-Side Only)
# ============================================
# These values are stored as Supabase Edge Function secrets.
# They are NEVER exposed to the client/browser bundle.
#
# To set these secrets, run:
#   supabase secrets set AI_API_KEY=your_key_here
#   supabase secrets set AI_BASE_URL=https://aicredits.in/v1
#   supabase secrets set AI_MODEL=google/gemini-flash-latest
#
# DO NOT add these to your .env.local file — they should only
# exist as Supabase Edge Function environment secrets.

# ============================================
# Development Settings
# ============================================

# Node environment
NODE_ENV=development

# ============================================
# Optional: Advanced Settings
# ============================================

# API timeout in milliseconds (default: 60000)
# VITE_API_TIMEOUT=60000

# Enable debug logging (default: false)
# VITE_DEBUG=false
